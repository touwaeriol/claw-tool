<?xml version="1.0" encoding="UTF-8"?>
<!--
  Claw-Tool WiX 安装脚本模板

  占位符（由 make-installer.mjs 替换）：
    {{APP_NAME}}      — 应用名称（含空格，如 "Claw Tool"）
    {{APP_VERSION}}   — 版本号（如 "0.1.0"）
    {{UPGRADE_CODE}}  — 固定 GUID，用于升级识别
    {{PRODUCT_CODE}}  — 每次构建唯一的 GUID
    {{EXE_NAME}}      — 主可执行文件名（如 "claw-tool.exe"）
    {{ICON_FILE}}     — .ico 图标文件绝对路径
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="{{PRODUCT_CODE}}"
           Name="{{APP_NAME}}"
           Language="1033"
           Version="{{APP_VERSION}}"
           Manufacturer="Claw-Tool"
           UpgradeCode="{{UPGRADE_CODE}}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="{{APP_NAME}} Installer"
             Comments="{{APP_NAME}} v{{APP_VERSION}}" />

    <!-- 支持升级安装：自动卸载旧版本 -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of {{APP_NAME}} is already installed." />

    <!-- 升级时从注册表读取之前的安装目录 -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PrevInstallDir"
                      Root="HKLM"
                      Key="Software\{{APP_NAME}}"
                      Name="InstallDir"
                      Type="raw" />
    </Property>

    <!-- 压缩到单个 cab 文件嵌入 MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- 安装目录结构 -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="{{APP_NAME}}" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="{{APP_NAME}}" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- 安装时将安装路径写入注册表（供后续升级检测） -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallDirRegistry" Guid="a1b2c3d4-5e6f-7a8b-9c0d-e1f2a3b4c5d6">
        <RegistryValue Root="HKLM"
                       Key="Software\{{APP_NAME}}"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\{{APP_NAME}}"
                       Name="Version"
                       Type="string"
                       Value="{{APP_VERSION}}" />
      </Component>

      <!-- 将内置 Node.js 目录添加到系统 PATH（Part="last" 放末尾，不干扰已有 Node.js） -->
      <!-- 卸载时自动移除（Permanent="no"） -->
      <Component Id="BundledNodePath" Guid="b2c3d4e5-6f7a-8b9c-0d1e-f2a3b4c5d6e7">
        <Environment Id="PATH_BUNDLED_NODE"
                     Name="PATH"
                     Value="[INSTALLFOLDER]node"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\{{APP_NAME}}"
                       Name="PathEnv"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 跳过创建系统还原点，加快安装/升级速度 -->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <!-- 应用图标（用于快捷方式和控制面板） -->
    <Icon Id="AppIcon.ico" SourceFile="{{ICON_FILE}}" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- 开始菜单快捷方式 -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="{{APP_NAME}}"
                  Target="[INSTALLFOLDER]{{EXE_NAME}}"
                  Icon="AppIcon.ico"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\{{APP_NAME}}" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 桌面快捷方式 -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="{{APP_NAME}}"
                  Target="[INSTALLFOLDER]{{EXE_NAME}}"
                  Icon="AppIcon.ico"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\{{APP_NAME}}" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 功能定义：引用 heat 生成的 Fragment + 快捷方式 -->
    <Feature Id="MainFeature" Title="{{APP_NAME}}" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallDirRegistry" />
      <ComponentRef Id="BundledNodePath" />
    </Feature>

    <!-- UI：含目录选择的安装界面（跳过许可协议页面） -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />

    <!-- 自定义安装界面图片（由 make-installer.mjs 从应用图标自动生成） -->
    <WixVariable Id="WixUIDialogBmp" Value="{{DIALOG_BMP}}" />
    <WixVariable Id="WixUIBannerBmp" Value="{{BANNER_BMP}}" />

    <UI>
      <!-- 跳过 License 页面：Welcome → 直接到 InstallDir -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
    </UI>

  </Product>
</Wix>
