{
  "name": "claw-tool",
  "version": "0.1.8",
  "description": "OpenClaw 图形化管理工具",
  "license": "MIT",
  "main": "dist/index.html",
  "node-main": "src/main/index.js",
  "window": {
    "title": "Claw Tool",
    "width": 1200,
    "height": 800,
    "min_width": 900,
    "min_height": 600,
    "icon": "src/assets/icons/icon.png"
  },
  "chromium-args": "--mixed-context",
  "scripts": {
    "dev": "vite",
    "dev:nw": "nwbuild --mode=run --glob=false .",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:win-x64": "node scripts/build.mjs --platform win --arch x64",
    "build:win-arm64": "node scripts/build.mjs --platform win --arch arm64",
    "build:mac-arm64": "node scripts/build.mjs --platform osx --arch arm64",
    "build:all": "node scripts/build.mjs --all",
    "clean": "node scripts/clean.mjs",
    "make:installer": "node scripts/make-installer.mjs",
    "make:installer:all": "node scripts/make-installer.mjs --all",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "element-plus": "^2.9.1",
    "express": "^4.21.0",
    "json5": "^2.2.3",
    "markdown-it": "^14.1.0",
    "openai": "^6.27.0",
    "pinia": "^2.3.0",
    "ssh2": "^1.16.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "nw": "^0.96.0-sdk",
    "nw-builder": "^4.12.2",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
